---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

// Импорт локальных изображений-заглушек от пользователя
import placeholder1 from '../assets/gallery/placeholder1.jpg';
import placeholder2 from '../assets/gallery/placeholder2.jpg';
import placeholder3 from '../assets/gallery/placeholder3.jpg';

// Изображения для галереи
const galleryItems = [
  {
    id: 1,
    title: "Воскресное поклонение",
    description: "Прославление и молитва воскресного служения общины",
    categories: ["ministries", "selah"],
    url: placeholder1
  },
  {
    id: 2,
    title: "Рождественское служение",
    description: "Празднование Рождества Господня в кругу общины",
    categories: ["holidays"],
    url: placeholder2
  },
  {
    id: 3,
    title: "Изучение Слова Божьего",
    description: "Глубокий разбор Писания и обсуждение в малых группах",
    categories: ["biblestudy", "homegroups"],
    url: placeholder3
  },
  {
    id: 4,
    title: "Молодежная встреча",
    description: "Обсуждение важных вопросов веры и дружеское общение",
    categories: ["ministries", "homegroups"],
    url: placeholder1
  },
  {
    id: 5,
    title: "Альфа-курс: Введение",
    description: "Первая встреча курса для ищущих ответы на главные вопросы жизни",
    categories: ["alphacourse"],
    url: placeholder2
  },
  {
    id: 6,
    title: "Атмосфера Селахи",
    description: "Минуты тишины, размышлений и глубокого безмолвного поклонения",
    categories: ["selah"],
    url: placeholder3
  },
  {
    id: 7,
    title: "Пасхальное торжество",
    description: "Светлое Воскресение Христово — праздничный декор и служба",
    categories: ["holidays"],
    url: placeholder1
  },
  {
    id: 8,
    title: "Домашняя встреча в кругу семьи",
    description: "Разделённая трапеза, поддержка и молитва друг за друга",
    categories: ["homegroups"],
    url: placeholder2
  },
  {
    id: 9,
    title: "Исследование Писания",
    description: "Открытые блокноты, искренний поиск Божьей воли",
    categories: ["biblestudy"],
    url: placeholder3
  },
  {
    id: 10,
    title: "Пастырская проповедь",
    description: "Служение Слова с кафедры церкви",
    categories: ["ministries"],
    url: placeholder1
  },
  {
    id: 11,
    title: "Рождественские свечи",
    description: "Символ пришедшего в мир Света — Иисуса Христа",
    categories: ["holidays", "selah"],
    url: placeholder2
  },
  {
    id: 12,
    title: "Альфа-курс: Дискуссия за чаем",
    description: "Разговор на равных в непринужденной и открытой атмосфере",
    categories: ["alphacourse"],
    url: placeholder3
  }
];

const filters = [
  { label: "Все", value: "all" },
  { label: "Служения", value: "ministries" },
  { label: "Праздники", value: "holidays" },
  { label: "Домашние группы", value: "homegroups" },
  { label: "Альфа-курс", value: "alphacourse" },
  { label: "Изучение Библии", value: "biblestudy" },
  { label: "Селахи", value: "selah" }
];
---

<BaseLayout title="Галерея — Церковь «Невеста Агнца»">
    <div class="pt-32 pb-24 px-6 relative overflow-hidden bg-paper min-h-screen">
        <!-- Солнце и исходящие лучи в фоне -->
        <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden">
            <!-- Блок солнца и лучей -->
            <div class="absolute top-[-800px] left-1/2 -translate-x-1/2 w-[1600px] h-[1600px] flex items-center justify-center">

                <!-- Слой 1: Задние лучи (тёплый янтарный, размытый) -->
                <div class="absolute w-[1600px] h-[1600px] rounded-full animate-spin-slow opacity-75 sun-rays-1" 
                     style="background: repeating-conic-gradient(from 0deg, rgba(251, 191, 36, 0.28) 0deg 15deg, transparent 15deg 40deg); filter: blur(12px); -webkit-mask-image: radial-gradient(circle, black 20%, transparent 82%); mask-image: radial-gradient(circle, black 20%, transparent 82%);">
                </div>

                <!-- Слой 2: Средние лучи (чёткие, в обратную сторону) -->
                <div class="absolute w-[1450px] h-[1450px] rounded-full animate-spin-reverse opacity-60 sun-rays-2" 
                     style="background: repeating-conic-gradient(from 30deg, rgba(254, 240, 138, 0.35) 0deg 10deg, transparent 10deg 50deg); filter: blur(6px); -webkit-mask-image: radial-gradient(circle, black 25%, transparent 88%); mask-image: radial-gradient(circle, black 25%, transparent 88%);">
                </div>

                <!-- Слой 3: God Rays — тонкие, резкие лучи -->
                <div class="absolute w-[1500px] h-[1500px] rounded-full animate-spin-godrays opacity-40 sun-rays-3" 
                     style="background: repeating-conic-gradient(from 15deg, rgba(255, 255, 255, 0.35) 0deg 3deg, transparent 3deg 24deg); filter: blur(2px); -webkit-mask-image: radial-gradient(circle, black 10%, transparent 70%); mask-image: radial-gradient(circle, black 10%, transparent 70%);">
                </div>

                <!-- 5. Цветовой переход по длине: белый у центра → янтарный к краям -->
                <div class="absolute w-[1600px] h-[1600px] rounded-full opacity-30"
                     style="background: radial-gradient(circle, rgba(255,255,255,0.5) 5%, rgba(251,191,36,0.25) 35%, rgba(180,120,30,0.1) 60%, transparent 80%); pointer-events: none;">
                </div>

                <!-- 3. Тёплая дымка / атмосфера -->
                <div class="absolute w-[900px] h-[900px] rounded-full sun-haze opacity-50"
                     style="background: radial-gradient(circle, rgba(255,236,179,0.6) 0%, rgba(251,191,36,0.15) 50%, transparent 80%); filter: blur(40px);">
                </div>

                <!-- Яркое свечение солнца -->
                <div class="absolute w-[450px] h-[450px] bg-amber-100/70 rounded-full blur-[50px] shadow-[0_0_150px_70px_rgba(251,191,36,0.55)] sun-glow"></div>

                <!-- 1. Пульсирующее ядро солнца -->
                <div class="absolute w-[200px] h-[200px] bg-white rounded-full blur-[20px] opacity-95 sun-core"></div>

                <!-- 4. Блики (lens flare) -->
                <div class="absolute w-[18px] h-[18px] bg-white/80 rounded-full blur-[4px] sun-flare-1" style="top: 48%; left: 56%;"></div>
                <div class="absolute w-[10px] h-[10px] bg-yellow-100/70 rounded-full blur-[3px] sun-flare-2" style="top: 52%; left: 42%;"></div>
                <div class="absolute w-[14px] h-[14px] bg-amber-100/60 rounded-full blur-[5px] sun-flare-3" style="top: 44%; left: 47%;"></div>
            </div>
        </div>
        
        <div class="container mx-auto relative z-10">
            <!-- Заголовок -->
            <div class="text-center mb-16 fade-up">
                <span class="text-gold-dark font-medium text-xs uppercase tracking-[0.2em] mb-2 block">мы</span>
                <h1 class="text-5xl md:text-6xl text-dark mb-4">Галерея</h1>
                <div class="title-decoration mb-6"></div>
            </div>

            <!-- Панель фильтров -->
            <div class="flex overflow-x-auto scrollbar-none md:flex-wrap md:justify-center gap-3 mb-12 fade-up pb-4 px-2 md:px-0 md:pb-0 snap-x">
                {filters.map((filter, index) => (
                    <button
                        class={`filter-btn py-2.5 px-6 border rounded-full text-xs font-semibold uppercase tracking-wider transition-all duration-300 cursor-pointer ${
                            index === 0
                                ? "bg-gold text-white border-gold shadow-glow"
                                : "border-gold/40 text-gold hover:border-gold hover:bg-gold/5"
                        }`}
                        data-filter={filter.value}
                    >
                        {filter.label}
                    </button>
                ))}
            </div>

            <!-- Сетка галереи -->
            <!-- Сетка галереи в стиле Pinterest (Masonry) -->
            <div class="columns-2 md:columns-3 lg:columns-4 gap-4 md:gap-6 [column-fill:_balance] mx-auto fade-up">
                {galleryItems.map((item) => (
                    <div
                        class="gallery-item group relative break-inside-avoid mb-6 overflow-hidden rounded-3xl bg-white border border-gray-100 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-500 cursor-pointer"
                        data-categories={item.categories.join(",")}
                    >
                        <Image
                            src={item.url}
                            alt=""
                            class="w-full h-auto object-cover transform group-hover:scale-105 transition duration-700 block"
                        />
                        <!-- Эффект затемнения при наведении (без текста) -->
                        <div class="absolute inset-0 bg-dark/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                    </div>
                ))}
            </div>
        </div>
    </div>

    <!-- Лайтбокс -->
    <div id="lightbox" class="fixed inset-0 z-[200] bg-dark/98 backdrop-blur-md hidden flex-col items-center justify-center">
        <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white p-2 focus:outline-none transition cursor-pointer" aria-label="Закрыть">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
        <div class="relative max-w-[90vw] max-h-[80vh] flex items-center justify-center">
            <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded-2xl shadow-2xl transition-transform duration-300">
        </div>
    </div>
</BaseLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        const buttons = document.querySelectorAll('.filter-btn');
        const items = document.querySelectorAll('.gallery-item');
        
        // Логика фильтрации
        buttons.forEach(button => {
            button.addEventListener('click', () => {
                const filter = button.getAttribute('data-filter');
                
                buttons.forEach(btn => {
                    btn.classList.remove('bg-gold', 'text-white', 'border-gold', 'shadow-glow');
                    btn.classList.add('border-gold/40', 'text-gold');
                });
                
                button.classList.remove('border-gold/40', 'text-gold');
                button.classList.add('bg-gold', 'text-white', 'border-gold', 'shadow-glow');
                
                items.forEach(item => {
                    const categories = item.getAttribute('data-categories')?.split(',') || [];
                    if (filter === 'all' || categories.includes(filter || '')) {
                        item.classList.remove('hidden');
                        setTimeout(() => {
                            item.classList.remove('opacity-0', 'scale-95');
                            item.classList.add('opacity-100', 'scale-100');
                        }, 10);
                    } else {
                        item.classList.add('opacity-0', 'scale-95');
                        item.classList.remove('opacity-100', 'scale-100');
                        setTimeout(() => {
                            item.classList.add('hidden');
                        }, 300);
                    }
                });
            });
        });

        // Логика лайтбокса
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
        const lightboxClose = document.getElementById('lightbox-close');

        items.forEach(item => {
            item.addEventListener('click', () => {
                const img = item.querySelector('img');

                if (img && lightbox && lightboxImg) {
                    lightboxImg.src = img.src;
                    
                    lightbox.classList.remove('hidden');
                    lightbox.classList.add('flex');
                    document.body.classList.add('menu-open'); // Блокировка скролла
                }
            });
        });

        function closeLightbox() {
            if (lightbox) {
                lightbox.classList.add('hidden');
                lightbox.classList.remove('flex');
                document.body.classList.remove('menu-open');
            }
        }

        lightboxClose?.addEventListener('click', closeLightbox);
        lightbox?.addEventListener('click', (e) => {
            if (e.target === lightbox) {
                closeLightbox();
            }
        });
        
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeLightbox();
            }
        });
    });
</script>

<style>
    /* === Вращение лучей === */
    @keyframes spin-slow {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    @keyframes spin-reverse {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(-360deg); }
    }
    @keyframes spin-godrays {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    .animate-spin-slow {
        animation: spin-slow 36s linear infinite;
    }
    .animate-spin-reverse {
        animation: spin-reverse 48s linear infinite;
    }
    .animate-spin-godrays {
        animation: spin-godrays 80s linear infinite;
    }

    /* === 1. Пульсация ядра солнца === */
    @keyframes sun-pulse {
        0%, 100% { transform: scale(1); opacity: 0.95; }
        50% { transform: scale(1.15); opacity: 1; }
    }
    .sun-core {
        animation: sun-pulse 6s ease-in-out infinite;
    }
    .sun-glow {
        animation: sun-pulse 6s ease-in-out infinite;
        animation-delay: 0.3s;
    }

    /* === 3. Дымка дышит === */
    @keyframes haze-breathe {
        0%, 100% { transform: scale(1); opacity: 0.5; }
        50% { transform: scale(1.08); opacity: 0.65; }
    }
    .sun-haze {
        animation: haze-breathe 8s ease-in-out infinite;
    }

    /* === 4. Блики мерцают === */
    @keyframes flare-twinkle-1 {
        0%, 100% { opacity: 0.8; transform: scale(1); }
        50% { opacity: 0.3; transform: scale(0.7); }
    }
    @keyframes flare-twinkle-2 {
        0%, 100% { opacity: 0.7; transform: scale(1); }
        40% { opacity: 0.2; transform: scale(0.5); }
    }
    @keyframes flare-twinkle-3 {
        0%, 100% { opacity: 0.6; transform: scale(1); }
        60% { opacity: 0.15; transform: scale(0.6); }
    }
    .sun-flare-1 {
        animation: flare-twinkle-1 4s ease-in-out infinite;
    }
    .sun-flare-2 {
        animation: flare-twinkle-2 5.5s ease-in-out infinite;
    }
    .sun-flare-3 {
        animation: flare-twinkle-3 7s ease-in-out infinite;
    }

    /* === Мобильная адаптация === */
    @media (max-width: 768px) {
        .sun-rays-1 {
            background: repeating-conic-gradient(from 0deg, rgba(251, 191, 36, 0.28) 0deg 6deg, transparent 6deg 30deg) !important;
            filter: blur(6px) !important;
        }
        .sun-rays-2 {
            background: repeating-conic-gradient(from 30deg, rgba(254, 240, 138, 0.35) 0deg 5deg, transparent 5deg 35deg) !important;
            filter: blur(5px) !important;
        }
        .sun-rays-3 {
            background: repeating-conic-gradient(from 15deg, rgba(255, 255, 255, 0.35) 0deg 2deg, transparent 2deg 20deg) !important;
            filter: blur(1px) !important;
        }
        .sun-flare-1, .sun-flare-2, .sun-flare-3 {
            display: none;
        }
    }
</style>
