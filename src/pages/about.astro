---
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutImage from '../assets/images/about-community.jpg';
import { Image } from 'astro:assets';
---

<BaseLayout title="О нас — Церковь «Невеста Агнца»">
    <div class="pt-32 pb-24 px-6 relative overflow-hidden bg-paper min-h-screen">
        <div class="absolute inset-0 pattern-grid opacity-10 pointer-events-none"></div>
        
        <!-- Яркие круги боке на заднем фоне -->
        <canvas id="about-bokeh-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-0 opacity-80"></canvas>
        
        <div class="container mx-auto max-w-4xl relative z-10">
            <div class="text-center mb-16 fade-up">
                <span class="text-gold-dark font-medium text-xs uppercase tracking-[0.2em] mb-2 block">Познакомьтесь с нами</span>
                <h1 class="text-5xl md:text-6xl text-dark">История и видение церкви</h1>
            </div>

            <div class="mb-16 fade-up">
                <Image src={aboutImage} alt="Община церкви Невеста Агнца" class="w-full h-[450px] object-cover rounded-3xl shadow-2xl" />
            </div>

            <div class="prose prose-lg max-w-none text-[#4a4a4a] space-y-8 font-normal leading-relaxed text-lg fade-up">
                <p>
                    Мы верим, что церковь призвана делиться с миром радостной вестью об Иисусе Христе. Наша цель — помочь каждому человеку узнать Бога лично, обрести надежду и опору в жизни. Мы стараемся поддерживать тех, кто оказался в трудной ситуации.
                </p>
                <p>
                    Для нас очень важны семейные ценности. Мы верим, что крепкие семьи строятся на любви, взаимном уважении и библейских принципах. Общаясь в домашних группах и воспитывая детей в доверии Богу, мы стремимся приносить свет и добро в жизнь нашего города.
                </p>
            </div>
        </div>
    </div>
</BaseLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        const canvas = document.getElementById('about-bokeh-canvas') as HTMLCanvasElement;
        if (!canvas) return;

        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let circles: Array<{x: number, y: number, r: number, baseVx: number, baseVy: number, color: [number, number, number, number]}> = [];
        let animationFrameId: number;
        let lastScrollY = window.scrollY;
        let auroraOffset = 0;
        
        let lastPulseTime = 0;
        let targetBoost = 1;
        let currentBoost = 1;

        const resize = () => {
            if (!canvas) return;
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;
            initCircles();
        };

        const initCircles = () => {
            circles = [];
            const colors: Array<[number, number, number, number]> = [
                [194, 157, 127, 0.35],
                [166, 123, 91, 0.25],
                [255, 255, 255, 0.45],
                [212, 168, 83, 0.2],
            ];
            const count = window.innerWidth <= 768 ? 6 : 14;
            for (let i = 0; i < count; i++) {
                circles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    r: Math.random() * 110 + 70,
                    baseVx: (Math.random() - 0.5) * 0.3,
                    baseVy: (Math.random() - 0.5) * 0.3,
                    color: colors[i % colors.length],
                });
            }
        };

        const draw = () => {
            if (!ctx || !canvas) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            const now = performance.now();

            // Aurora wave
            auroraOffset += 0.003;
            const auroraY = canvas.height * 0.45;
            for (let layer = 0; layer < 3; layer++) {
                ctx.beginPath();
                const amp = 40 + layer * 20;
                const freq = 0.003 - layer * 0.0005;
                const alpha = 0.06 - layer * 0.015;
                ctx.moveTo(0, auroraY);
                for (let x = 0; x <= canvas.width; x += 4) {
                    const y = auroraY + Math.sin(x * freq + auroraOffset + layer * 1.5) * amp
                            + Math.sin(x * freq * 1.7 + auroraOffset * 1.3) * amp * 0.5;
                    ctx.lineTo(x, y);
                }
                ctx.lineTo(canvas.width, canvas.height);
                ctx.lineTo(0, canvas.height);
                ctx.closePath();
                const grad = ctx.createLinearGradient(0, auroraY - 60, 0, auroraY + 200);
                grad.addColorStop(0, `rgba(194, 157, 127, ${alpha})`);
                grad.addColorStop(0.5, `rgba(212, 168, 83, ${alpha * 1.5})`);
                grad.addColorStop(1, 'rgba(212, 168, 83, 0)');
                ctx.fillStyle = grad;
                ctx.fill();
            }

            // Scroll-reactive bokeh
            const currentScroll = window.scrollY;
            const delta = Math.abs(currentScroll - lastScrollY);
            lastScrollY = currentScroll;

            if (delta > 5 && now - lastPulseTime > 5000) {
                targetBoost = 3;
                lastPulseTime = now;
            }

            targetBoost = Math.max(1, targetBoost - 0.005);
            currentBoost += (targetBoost - currentBoost) * 0.015;

            circles.forEach(c => {
                c.x += c.baseVx * currentBoost;
                c.y += c.baseVy * currentBoost;

                if (c.x - c.r < 0 || c.x + c.r > canvas.width) c.baseVx *= -1;
                if (c.y - c.r < 0 || c.y + c.r > canvas.height) c.baseVy *= -1;

                const [r, g, b, a] = c.color;
                const grad = ctx.createRadialGradient(c.x, c.y, 0, c.x, c.y, c.r);
                grad.addColorStop(0, `rgba(${r},${g},${b},${a * Math.min(currentBoost, 2.5)})`);
                grad.addColorStop(1, 'rgba(255,255,255,0)');
                ctx.beginPath();
                ctx.arc(c.x, c.y, c.r, 0, Math.PI * 2);
                ctx.fillStyle = grad;
                ctx.fill();
            });

            animationFrameId = requestAnimationFrame(draw);
        };

        window.addEventListener('resize', resize);
        resize();
        draw();

        document.addEventListener('astro:before-swap', () => {
            cancelAnimationFrame(animationFrameId);
            window.removeEventListener('resize', resize);
        }, { once: true });
    });
</script>
