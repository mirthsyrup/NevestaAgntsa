---
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutImage from '../assets/images/about-community.jpg';
import { Image } from 'astro:assets';
---

<BaseLayout title="О нас — Церковь «Невеста Агнца»">
    <div class="pt-32 pb-24 px-6 relative overflow-hidden bg-paper min-h-screen">
        <div class="absolute inset-0 pattern-grid opacity-10 pointer-events-none"></div>
        
        <!-- Яркие круги боке на заднем фоне -->
        <canvas id="about-bokeh-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-0 opacity-80"></canvas>
        
        <div class="container mx-auto max-w-4xl relative z-10">
            <div class="text-center mb-16 fade-up">
                <span class="text-gold-dark font-medium text-xs uppercase tracking-[0.2em] mb-2 block">Познакомьтесь с нами</span>
                <h1 class="text-5xl md:text-6xl text-dark">История и видение церкви</h1>
            </div>

            <div class="mb-16 fade-up">
                <Image src={aboutImage} alt="Община церкви Невеста Агнца" class="w-full h-[450px] object-cover rounded-3xl shadow-2xl" />
            </div>

            <div class="prose prose-lg max-w-none text-[#4a4a4a] space-y-8 font-normal leading-relaxed text-lg fade-up">
                <p>
                    Мы верим, что церковь призвана делиться с миром радостной вестью об Иисусе Христе. Наша цель — помочь каждому человеку узнать Бога лично, обрести надежду и опору в жизни. Мы стараемся поддерживать тех, кто оказался в трудной ситуации.
                </p>
                <p>
                    Для нас очень важны семейные ценности. Мы верим, что крепкие семьи строятся на любви, взаимном уважении и библейских принципах. Общаясь в домашних группах и воспитывая детей в доверии Богу, мы стремимся приносить свет и добро в жизнь нашего города.
                </p>
            </div>
        </div>
    </div>
</BaseLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        const canvas = document.getElementById('about-bokeh-canvas') as HTMLCanvasElement;
        if (!canvas) return;

        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let circles: Array<{x: number, y: number, r: number, vx: number, vy: number, color: string}> = [];
        let animationFrameId: number;

        const resize = () => {
            if (!canvas) return;
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;
            initCircles();
        };

        const initCircles = () => {
            circles = [];
            const colors = [
                'rgba(194, 157, 127, 0.4)', // gold-light
                'rgba(166, 123, 91, 0.3)',  // gold
                'rgba(255, 255, 255, 0.6)', // white
            ];
            const count = window.innerWidth <= 768 ? 5 : 12;
            for (let i = 0; i < count; i++) {
                const r = Math.random() * 100 + 80; // 80px - 180px (made bigger)
                circles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    r: r,
                    vx: (Math.random() - 0.5) * 0.25,
                    vy: (Math.random() - 0.5) * 0.25,
                    color: colors[i % colors.length]
                });
            }
        };

        const draw = () => {
            if (!ctx || !canvas) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            circles.forEach(c => {
                c.x += c.vx;
                c.y += c.vy;

                if (c.x - c.r < 0 || c.x + c.r > canvas.width) c.vx *= -1;
                if (c.y - c.r < 0 || c.y + c.r > canvas.height) c.vy *= -1;

                const grad = ctx.createRadialGradient(c.x, c.y, 0, c.x, c.y, c.r);
                grad.addColorStop(0, c.color);
                grad.addColorStop(1, 'rgba(255, 255, 255, 0)');
                
                ctx.beginPath();
                ctx.arc(c.x, c.y, c.r, 0, Math.PI * 2);
                ctx.fillStyle = grad;
                ctx.fill();
            });

            animationFrameId = requestAnimationFrame(draw);
        };

        window.addEventListener('resize', resize);
        resize();
        draw();

        document.addEventListener('astro:before-swap', () => {
            cancelAnimationFrame(animationFrameId);
            window.removeEventListener('resize', resize);
        }, { once: true });
    });
</script>
