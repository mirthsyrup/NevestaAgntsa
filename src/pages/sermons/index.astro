---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SermonCard from '../../components/SermonCard.astro';
import { getCollection } from 'astro:content';

const sermons = await getCollection('sermons');
---

<BaseLayout title="Проповеди — Церковь «Невеста Агнца»">
    <div class="pt-32 pb-24 bg-paper relative overflow-hidden min-h-screen">
        <!-- Тени от окна и жалюзи (Gobo) в фоне -->
        <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden">
            <!-- Естественный свет из окна (подсветка фона) -->
            <div class="absolute inset-0 gobo-window-light"></div>
            
            <!-- Оконная рама с дыханием -->
            <div class="absolute -inset-[5%] window-overlay"></div>
            
            <!-- Тень от листвы за окном -->
            <div class="absolute inset-0 window-tree-shadow">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 800" class="w-full h-full">
                    <filter id="window-tree-blur">
                        <feGaussianBlur stdDeviation="24" />
                    </filter>
                    <g filter="url(#window-tree-blur)" fill="rgba(22, 22, 22, 0.16)">
                        <circle cx="200" cy="150" r="80" />
                        <circle cx="260" cy="180" r="60" />
                        <circle cx="320" cy="220" r="50" />
                        <circle cx="120" cy="90" r="90" />
                    </g>
                </svg>
            </div>
            
            <!-- Интерактивный свет от мыши поверх теней -->
            <canvas id="sermons-canvas" class="absolute inset-0 w-full h-full pointer-events-none mix-blend-overlay"></canvas>
        </div>

        <div class="container mx-auto relative z-10">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 gap-6 fade-up px-6 md:px-6">
                <div>
                    <span class="text-gold-dark font-medium text-xs uppercase tracking-[0.2em] mb-2 block">Служение слова</span>
                    <h1 class="text-5xl md:text-6xl text-dark mb-4">Архив проповедей</h1>
                    <p class="text-gray-500 text-lg leading-relaxed">
                        Записи воскресных, будничных и праздничных трансляций.
                    </p>
                </div>
                <a href="https://rutube.ru/channel/42730775/" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 text-sm font-medium uppercase tracking-widest hover:text-gold transition self-end md:self-auto">
                    Все видео <i data-feather="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition"></i>
                </a>
            </div>

            <div class="flex overflow-x-auto snap-x snap-mandatory gap-6 pt-4 -mt-4 pb-6 scrollbar-none md:grid md:grid-cols-3 md:gap-10 md:pb-0 px-6 md:px-6 scroll-px-6">
                {sermons.map((sermon, i) => (
                    <SermonCard
                        title={sermon.data.title}
                        date={sermon.data.date}
                        speaker={sermon.data.speaker}
                        embedId={sermon.data.embedId}
                        coverImage={sermon.data.coverImage}
                        description={sermon.body}
                        delay={i * 100}
                    />
                ))}
            </div>
        </div>
    </div>
</BaseLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        const canvas = document.getElementById('sermons-canvas') as HTMLCanvasElement;
        if (!canvas) return;

        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let animationFrameId: number;
        let mouseX = -1000;
        let mouseY = -1000;
        let currentX = -1000;
        let currentY = -1000;

        const resize = () => {
            if (!canvas) return;
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;
        };

        const draw = () => {
            if (!ctx || !canvas) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Плавное следование за мышью
            if (mouseX !== -1000) {
                if (currentX === -1000) {
                    currentX = mouseX;
                    currentY = mouseY;
                } else {
                    currentX += (mouseX - currentX) * 0.05;
                    currentY += (mouseY - currentY) * 0.05;
                }

                const gradient = ctx.createRadialGradient(currentX, currentY, 0, currentX, currentY, 400);
                gradient.addColorStop(0, 'rgba(255, 252, 240, 0.9)');
                gradient.addColorStop(0.2, 'rgba(255, 248, 225, 0.6)');
                gradient.addColorStop(0.5, 'rgba(254, 243, 210, 0.25)');
                gradient.addColorStop(1, 'rgba(254, 243, 210, 0)');

                ctx.fillStyle = gradient;
                ctx.beginPath();
                ctx.arc(currentX, currentY, 400, 0, Math.PI * 2);
                ctx.fill();
            }

            animationFrameId = requestAnimationFrame(draw);
        };

        const handleMouseMove = (e: MouseEvent) => {
            const rect = canvas.getBoundingClientRect();
            mouseX = e.clientX - rect.left;
            mouseY = e.clientY - rect.top;
        };

        const handleMouseLeave = () => {
            mouseX = -1000;
            mouseY = -1000;
            currentX = -1000;
            currentY = -1000;
        };

        window.addEventListener('resize', resize);
        
        const outerDiv = canvas.parentElement?.parentElement; // .bg-paper container
        outerDiv?.addEventListener('mousemove', handleMouseMove as EventListener);
        outerDiv?.addEventListener('mouseleave', handleMouseLeave);

        resize();
        draw();

        document.addEventListener('astro:before-swap', () => {
            cancelAnimationFrame(animationFrameId);
            window.removeEventListener('resize', resize);
            outerDiv?.removeEventListener('mousemove', handleMouseMove as EventListener);
            outerDiv?.removeEventListener('mouseleave', handleMouseLeave);
        }, { once: true });
    });
</script>

<style>
    .gobo-window-light {
        background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.8) 0%, transparent 100%);
    }

    .window-overlay {
        position: absolute;
        inset: -10%;
        background: linear-gradient(135deg, transparent 30%, rgba(22, 22, 22, 0.08) 45%, rgba(22, 22, 22, 0.15) 50%, rgba(22, 22, 22, 0.08) 55%, transparent 70%);
        background-size: 200% 200%;
        filter: blur(16px);
        opacity: 0.95;
        transform: rotate(-10deg);
        animation: window-breath-page 16s ease-in-out infinite alternate;
    }

    .window-overlay::before {
        content: '';
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
            45deg,
            transparent,
            transparent 120px,
            rgba(0, 0, 0, 0.07) 120px,
            rgba(0, 0, 0, 0.07) 170px
        );
    }

    .window-tree-shadow {
        position: absolute;
        inset: -5%;
        filter: blur(4px); /* Добавочное сглаживание к SVG фильтру */
        opacity: 0.9;
        animation: tree-drift-page 22s ease-in-out infinite alternate;
    }

    @keyframes window-breath-page {
        0% { transform: rotate(-10deg) scale(1) translate(0, 0); opacity: 0.85; }
        50% { transform: rotate(-9.2deg) scale(1.03) translate(18px, -10px); opacity: 0.95; }
        100% { transform: rotate(-10.8deg) scale(0.97) translate(-10px, 15px); opacity: 0.85; }
    }

    @keyframes tree-drift-page {
        0% { transform: translate(0, 0) rotate(0deg) scale(1); }
        50% { transform: translate(30px, -20px) rotate(3deg) scale(1.08); }
        100% { transform: translate(-20px, 25px) rotate(-2.5deg) scale(0.95); }
    }
</style>
