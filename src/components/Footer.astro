---
import { Image } from 'astro:assets';
import footerBg from '../assets/images/footer-bg.jpg';
import { contacts } from '../data/contacts';
---
<footer id="contact" class="relative pt-24 pb-8 text-white">
    <div class="absolute -top-16 inset-x-0 bottom-0 z-0" style="mask-image: linear-gradient(to bottom, transparent 0%, black 64px, black 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 64px, black 100%);">
        <Image src={footerBg} alt="" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-[#2b221b]/85 mix-blend-multiply"></div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="grid md:grid-cols-2 gap-16 items-start">
            
            <div class="fade-up">
                <h2 class="text-6xl font-serif text-[#E5D4C3] mb-8 tracking-wide">Контакты</h2>
                
                <div class="space-y-8 font-light tracking-wide text-lg text-white/80">
                    <div>
                        <p>{contacts.city}</p>
                        <p class="flex items-center gap-2 flex-wrap">
                            <span>{contacts.address}</span>
                            <a href={contacts.mapUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold uppercase tracking-wider border border-gold/40 hover:border-gold hover:bg-gold hover:text-white rounded-full transition-all duration-300">
                                <i data-feather="map-pin" class="w-3.5 h-3.5 text-gold-light"></i>
                                <span>На карте</span>
                            </a>
                        </p>
                    </div>

                    <div class="space-y-1">
                        <p>Телефон: <a href={`tel:${contacts.phone}`} aria-label={`Позвонить: ${contacts.phoneFormatted}`} class="hover:text-gold transition">{contacts.phoneFormatted}</a></p>
                        <p>Email: <a href={`mailto:${contacts.email}`} aria-label={`Написать на ${contacts.email}`} class="hover:text-gold transition">{contacts.email}</a></p>
                    </div>
                    
                    <div class="pt-4">
                        <h3 class="text-sm font-bold uppercase tracking-widest mb-4 text-[#A67B5B]">Соцсети</h3>
                        <div class="flex gap-4">
                            <a href="https://rutube.ru/channel/42730775/" target="_blank" rel="noopener noreferrer" aria-label="Rutube" class="hover:text-gold transition transform hover:scale-110">
                                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 2 21 12 3 22 3 2"></polygon></svg>
                            </a>
                            <a href="https://t.me/nevestaagntsa" target="_blank" rel="noopener noreferrer" aria-label="Telegram" class="hover:text-gold transition transform hover:scale-110">
                                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                            </a>
                             <a href="https://max.ru/join/M3Dv6oeVwqV-IdYiKvuuUPg8D1X6905NkvuNQjQW4TE" target="_blank" rel="noopener noreferrer" aria-label="MAX" class="hover:text-gold transition transform hover:scale-110 ml-1">
                                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="80 80 840 840" fill="none" stroke="currentColor" stroke-width="52.5" stroke-linecap="round" stroke-linejoin="round"><path d="M508.211 878.328c-75.007 0-109.864-10.95-170.453-54.75-38.325 49.275-159.686 87.783-164.979 21.9 0-49.456-10.95-91.248-23.36-136.873-14.782-56.21-31.572-118.807-31.572-209.508 0-216.626 177.754-379.597 388.357-379.597 210.785 0 375.947 171.001 375.947 381.604.707 207.346-166.595 376.118-373.94 377.224m3.103-571.585c-102.564-5.292-182.499 65.7-200.201 177.024-14.6 92.162 11.315 204.398 33.397 210.238 10.585 2.555 37.23-18.98 53.837-35.587a189.8 189.8 0 0 0 92.71 33.032c106.273 5.112 197.08-75.794 204.215-181.95 4.154-106.382-77.67-196.486-183.958-202.574Z"/></svg>
                             </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="fade-up md:pl-10 md:border-l border-white/10">
                <h3 class="text-xl font-bold mb-6 text-[#A67B5B] uppercase tracking-widest">Время служений</h3>
                
                <div class="space-y-4 text-white/90 text-lg font-light">
                    {contacts.schedule.map(item => (
                        'events' in item ? (
                            <div class="border-b border-white/10 pb-2 space-y-1">
                                {item.events.map((event, idx) => (
                                    <div class="flex justify-between">
                                        <div class="flex gap-4">
                                            {event.day ? (
                                                <span class="w-32 md:w-36 shrink-0">{event.day}</span>
                                            ) : (
                                                <span class={`w-32 md:w-36 shrink-0 ${idx > 0 ? "invisible select-none" : ""}`}>{item.day}</span>
                                            )}
                                            <span>{event.name}</span>
                                        </div>
                                        <span>{event.time}</span>
                                    </div>
                                ))}
                            </div>
                        ) : (
                            <div class="flex justify-between border-b border-white/10 pb-2">
                                <div class="flex gap-4">
                                    <span class="w-32 md:w-36 shrink-0">{item.day}</span>
                                    {'name' in item && <span class="text-white/70">{item.name}</span>}
                                </div>
                                {'isSunday' in item ? (
                                    <span class="sunday-time" data-summer-time="17:00" data-default-time="10:00">{item.time}</span>
                                ) : (
                                    <span>{item.time}</span>
                                )}
                            </div>
                        )
                    ))}
                    <div class="pt-4 text-sm text-white/50 italic">
                        *Возможны изменения в праздничные дни
                    </div>
                </div>
            </div>

        </div>
        
        <div class="mt-20 pt-8 border-t border-white/10 text-center text-xs text-white/30 uppercase tracking-[0.2em]">
            &copy; {new Date().getFullYear()} {contacts.copyright}<br>{contacts.churchName}
        </div>
    </div>

    <script is:inline>
        (function() {
            const m = new Date().getMonth();
            const isSummerTime = m >= 5 && m <= 7;
            document.querySelectorAll('.sunday-time').forEach(el => {
                el.textContent = isSummerTime ? el.getAttribute('data-summer-time') : el.getAttribute('data-default-time');
            });
        })();
    </script>
</footer>
