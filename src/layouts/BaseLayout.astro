---
import { ViewTransitions } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Preloader from '../components/Preloader.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;

const displayTitle = (title || "NevestaAgntsa")
  .replace(/— Церковь «Невеста Агнца»/g, "— NevestaAgntsa")
  .replace(/— Церковь "Невеста Агнца"/g, "— NevestaAgntsa")
  .replace(/Церковь "Невеста Агнца"/g, "NevestaAgntsa")
  .replace(/Церковь «Невеста Агнца»/g, "NevestaAgntsa");

const { pathname } = Astro.url;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = pathname.replace(/\/$/, "");
const isHome = currentPath === basePath || currentPath === "" || currentPath === "/" || currentPath === `${basePath}/index.html` || currentPath === "/index.html";

const pageTransition = {
  forwards: {
    old: {
      name: 'fadeOutHero',
      duration: '0.3s',
      easing: 'ease-out',
      fillMode: 'both',
    },
    new: {
      name: 'blurInHero',
      duration: '0.3s',
      easing: 'ease-out',
      fillMode: 'both',
    }
  },
  backwards: {
    old: {
      name: 'fadeOutHero',
      duration: '0.3s',
      easing: 'ease-out',
      fillMode: 'both',
    },
    new: {
      name: 'blurInHero',
      duration: '0.3s',
      easing: 'ease-out',
      fillMode: 'both',
    }
  }
};
---

<!DOCTYPE html>
<html lang="ru" class="scroll-smooth">
<head>
    <SEO title={displayTitle} description={description} image={image} />
    <title>{displayTitle}</title>
    
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rubik+Bubbles&family=Lora:ital,wght@0,400..700;1,400..700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/feather-icons/4.29.2/feather.min.js" integrity="sha512-zMm7+ZQ8AZr1r3W8Z8lDATkH05QG5Gm2xc6MlsCdBz9l6oE8Y7IXByMgSm/rdRQrhuHt99HAYfMljBOEZ68q5A==" crossorigin="anonymous" referrerpolicy="no-referrer" defer is:inline></script>
    <ViewTransitions />
    <script is:inline>
        if (history.scrollRestoration) {
            history.scrollRestoration = 'manual';
        }
        window.scrollTo(0, 0);
        window.addEventListener('load', () => {
            window.scrollTo(0, 0);
        });
        window.addEventListener('pageshow', () => {
            if (window.innerWidth <= 768) {
                setTimeout(() => {
                    window.scrollTo(0, 0);
                }, 50);
            }
        });
    </script>
</head>
<body class="antialiased selection:bg-gold selection:text-white relative bg-paper text-[#161616]">

    <Preloader />
    <Header />

    <main transition:animate={pageTransition}>
        <slot />
    </main>

    {isHome && <Footer />}

    <!-- Модальное окно событий -->
    <div id="event-modal" class="fixed inset-0 z-[200] bg-dark/80 backdrop-blur-md hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="bg-paper border border-white/20 rounded-[2.5rem] p-8 md:p-10 max-w-xl w-full relative shadow-2xl transition-all duration-300 transform scale-95 opacity-0" id="event-modal-card">
            <!-- Кнопка закрытия -->
            <button id="event-modal-close" class="absolute top-6 right-6 text-gray-400 hover:text-dark p-2 focus:outline-none transition cursor-pointer" aria-label="Закрыть">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <!-- 3 текстовых поля разного размера -->
            <p class="text-dark text-2xl font-googlesans leading-relaxed mb-6" id="modal-title">...</p>
            <p class="text-gray-600 text-base leading-relaxed mb-6" id="modal-description">...</p>
            <p class="text-gray-400 text-sm leading-relaxed" id="modal-info">...</p>
        </div>
    </div>

    <!-- Модальное окно описания проповеди -->
    <div id="sermon-modal" class="fixed inset-0 z-[200] bg-dark/80 backdrop-blur-md hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="sermon-modal-title">
        <div class="bg-paper border border-white/20 rounded-[2.5rem] p-8 md:p-10 max-w-xl w-full relative shadow-2xl transition-all duration-300 transform scale-95 opacity-0" id="sermon-modal-card">
            <!-- Кнопка закрытия -->
            <button id="sermon-modal-close" class="absolute top-6 right-6 text-gray-400 hover:text-dark p-2 focus:outline-none transition cursor-pointer" aria-label="Закрыть">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <!-- Содержимое -->
            <h3 class="text-dark text-2xl font-googlesans mb-4" id="sermon-modal-title">...</h3>
            <p class="text-gray-600 text-base leading-relaxed" id="sermon-modal-description">...</p>
        </div>
    </div>

    <script>
        // Универсальная функция для управления модальными окнами
        function createModal(config: {
            modalId: string;
            cardId: string;
            closeId: string;
            triggerSelector: string;
            populateCallback: (button: HTMLElement) => void;
        }) {
            const modal = document.getElementById(config.modalId);
            const card = document.getElementById(config.cardId);
            const closeBtn = document.getElementById(config.closeId);

            function open(button: HTMLElement) {
                if (!modal || !card) return;
                config.populateCallback(button);
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.classList.add('menu-open');
                setTimeout(() => {
                    card.classList.remove('scale-95', 'opacity-0');
                    card.classList.add('scale-100', 'opacity-100');
                }, 10);
            }

            function close() {
                if (!modal || !card) return;
                card.classList.remove('scale-100', 'opacity-100');
                card.classList.add('scale-95', 'opacity-0');
                setTimeout(() => {
                    modal.classList.add('hidden');
                    modal.classList.remove('flex');
                    document.body.classList.remove('menu-open');
                }, 300);
            }

            document.querySelectorAll(config.triggerSelector)
                .forEach(btn => btn.addEventListener('click', () => open(btn as HTMLElement)));
            closeBtn?.addEventListener('click', close);
            modal?.addEventListener('click', (e) => {
                if (e.target === modal) close();
            });

            return close;
        }

        // Инициализация после загрузки страниц через ViewTransitions
        document.addEventListener('astro:page-load', () => {
            // Feather icons replacement
            if (window.feather) {
                window.feather.replace();
            }

            // Intersection Observer для анимаций появления (.fade-up)
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.1 });
            document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

            // Модальное окно событий
            const closeEventModal = createModal({
                modalId: 'event-modal',
                cardId: 'event-modal-card',
                closeId: 'event-modal-close',
                triggerSelector: '.event-details-btn',
                populateCallback: (button) => {
                    const modalTitle = document.getElementById('modal-title');
                    const modalDescription = document.getElementById('modal-description');
                    const modalInfo = document.getElementById('modal-info');
                    if (modalTitle) modalTitle.textContent = button.getAttribute('data-title') || '';
                    if (modalDescription) modalDescription.textContent = button.getAttribute('data-description') || '';
                    if (modalInfo) {
                        const time = button.getAttribute('data-time') || '';
                        const location = button.getAttribute('data-location') || '';
                        modalInfo.textContent = `${time} • ${location}`;
                    }
                }
            });

            // Модальное окно проповедей
            const closeSermonModal = createModal({
                modalId: 'sermon-modal',
                cardId: 'sermon-modal-card',
                closeId: 'sermon-modal-close',
                triggerSelector: '.sermon-info-btn',
                populateCallback: (button) => {
                    const sermonTitle = document.getElementById('sermon-modal-title');
                    const sermonDesc = document.getElementById('sermon-modal-description');
                    if (sermonTitle) sermonTitle.textContent = button.getAttribute('data-title') || '';
                    if (sermonDesc) sermonDesc.textContent = button.getAttribute('data-description') || '';
                }
            });

            // Закрытие модалок по Escape
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    closeEventModal();
                    closeSermonModal();
                }
            });
        });
    </script>
</body>
</html>
